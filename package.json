{
  "name": "blockfire",
  "productName": "Blockfire",
  "version": "1.1.0",
  "private": true,
  "description": "A blocky voxel shooter with multiplayer and a Minecraft-format skin editor.",
  "author": "Blockfire",
  "license": "MIT",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "build": "node tools/build.mjs",
    "start": "npx serve . -l 8080",
    "server": "node server/server.cjs",
    "app": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --publish never"
  },
  "dependencies": {
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "0.28.2",
    "three": "0.186.1"
  },
  "build": {
    "appId": "io.github.blockfire.game",
    "productName": "Blockfire",
    "copyright": "Blockfire",
    "files": [
      "index.html",
      "desktop/**",
      "server/**",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Blockfire",
      "artifactName": "Blockfire-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Blockfire-${version}-portable.exe"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "build/icon.png"
    }
  }
}
